{
  "name": "screation-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply screation --local --persist-to .wrangler/state",
    "db:migrate": "wrangler d1 migrations apply screation --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": { "wrangler": "^4.40.0" }
}
