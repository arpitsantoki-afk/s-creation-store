{
  "name": "screation-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "db:init:local": "wrangler d1 execute screation --local --persist-to .wrangler/state --file=schema.sql",
    "db:init": "wrangler d1 execute screation --remote --file=schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": { "wrangler": "^4.40.0" }
}
